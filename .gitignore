# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Track the example launch configuration but ignore personal/IDE state files.
# Result: `.vscode/launch.json` (committed), `.vscode/launch.json.example` (committed),
#         everything else under `.vscode/` ignored.
!.vscode/launch.json
!.vscode/launch.json.example
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment variables / Secret tokens
# Only the populated local file is ignored. Keep `.env.example` in version control
# so newcomers have a documented template to copy from.
.env
.env.*
!.env.example
