# ─────────────────────────────────────────────────────────────────────────────
# Fulɓe Connect — environment variables template
# ─────────────────────────────────────────────────────────────────────────────
#
# ⚠️  DO NOT COMMIT YOUR REAL `.env` FILE.
#     This `.env.example` file IS committed and serves as documentation.
#
# Setup:
#   1. Copy this file to `.env` (same name, no `.example` suffix):
#        cp .env.example .env
#   2. Fill in the values below with your own Supabase project credentials.
#   3. Launch the app with:
#        flutter run --dart-define-from-file=.env
#
# To find these values:
#   • Supabase Dashboard → https://app.supabase.com → your project
#   • Project Settings  → API
#     - "Project URL"                → SUPABASE_URL
#     - "Publishable key" (sb_publishable_…)
#       or legacy  "anon / public"   → SUPABASE_PUBLISHABLE_KEY
#
# Both variables are read by `lib/core/constants/app_constants.dart` at
# compile time via `String.fromEnvironment(...)`. If a variable is missing,
# the app falls back to a placeholder URL and auth/network calls WILL fail
# with a `SocketException` (e.g. "Failed host lookup: 'placeholder.supabase.co'").
# ─────────────────────────────────────────────────────────────────────────────


# ── Supabase ────────────────────────────────────────────────────────────────

# Your Supabase project URL.
# Example: https://abcdefghijkl.supabase.co
# ⚠️  No trailing slash.
SUPABASE_URL=https://zhpzznanatsnvptmoqpf.supabase.co

# Your Supabase publishable (or anon) key.
# Example: sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# ⚠️  This is a PUBLIC key — safe to ship in the app bundle.
#     Never put the `service_role` key here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_4PstkAbaWyXMCj4SB7rF6g_dj0J8psN

# Agora.io — App ID pour les appels audio/vidéo 1-to-1.
# Créez un projet gratuit sur https://console.agora.io
# Récupérez l'App ID (pas le App Certificate — celui-ci reste côté serveur).
# ⚠️  En dev, l'App ID seul suffit SI le App Certificate est désactivé.
#     En production, générez des tokens via un Edge Function Supabase.
AGORA_APP_ID=01a56a54facb4a3faba76bf033e407e9

# Agora.io — App Certificate (optionnel, pour génération de token).
# Si renseigné, l'app génère automatiquement un token valide pour chaque appel.
# Si absent, le App Certificate doit être DÉSACTIVÉ dans la console Agora.
#
# À trouver dans : console.agora.io → votre projet →
#   Develop → Primary Certificate (ou App Certificate)
#
# ⚠️  Le certificat est compilé dans le binaire — pour la production,
#     préférez un Edge Function Supabase qui génère les tokens côté serveur.
AGORA_APP_CERTIFICATE=2d7122d04a0b4cc4a5c96e334fa47ebf

GITHUB_TOKEN=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